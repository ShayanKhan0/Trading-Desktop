# ---------------------------------------------------------------------------
# Two connection strings. On Neon both are on the project dashboard: the pooled
# one has "-pooler" in the host, the direct one does not.
#
# If your database has no connection pooler, set BOTH to the same direct string.
# ---------------------------------------------------------------------------

# Runtime queries — the POOLED string on a serverless host such as Vercel.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Migrations — the DIRECT (unpooled) string. Prisma Migrate needs an advisory
# lock, which a transaction-mode pooler cannot hold.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
