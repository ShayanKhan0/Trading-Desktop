# PostgreSQL connection string (Neon, Supabase, Railway, or self-hosted)
# Example (Neon): postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
